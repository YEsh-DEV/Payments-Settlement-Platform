# ==============================================================================
# PayCore Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the services locally:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit .env or real credentials to source control.
# - The 'prod' Spring profile will fail startup if default/empty secrets are detected.
# ==============================================================================

# --- Active Spring Profile (dev, sim, prod) ---
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL Database Credentials & Topology ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_password

# Database Names
IDENTITY_DB_NAME=identity
LEDGER_DB_NAME=ledger
SETTLEMENT_DB_NAME=settlement

# Identity Service DB Credentials
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_dev_password
IDENTITY_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${IDENTITY_DB_NAME}

# Ledger Service DB Credentials
LEDGER_DB_USER=ledger_user
LEDGER_DB_PASSWORD=ledger_dev_password
LEDGER_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${LEDGER_DB_NAME}

# Settlement Service DB Credentials
SETTLEMENT_DB_USER=settlement_user
SETTLEMENT_DB_PASSWORD=settlement_dev_password
SETTLEMENT_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${SETTLEMENT_DB_NAME}

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Apache Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_LEDGER_EVENTS=ledger.domain-events
KAFKA_TOPIC_SETTLEMENT_EVENTS=settlement.events
KAFKA_TOPIC_LEDGER_DLQ=ledger.domain-events.dlq

# --- Identity & Cryptographic Security ---
# RSA Key Pair paths or base64 encoded strings
JWT_PRIVATE_KEY_PATH=/etc/paycore/keys/private.pem
JWT_PUBLIC_KEY_PATH=/etc/paycore/keys/public.pem
JWT_KEY_ID=key-2026-v1
JWT_ISSUER=paycore-identity
JWT_AUDIENCE=paycore
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=900
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=604800

# Service-to-Service Machine Credentials
SERVICE_CLIENT_ID=settlement-service
SERVICE_CLIENT_SECRET=settlement_dev_secret

# --- Ledger Service Configuration ---
# Active Hot-Account Balance Strategy: PESSIMISTIC, LATE_LOCK, STRIPED, LEDGER_ONLY, BATCHED
LEDGER_POSTING_STRATEGY=STRIPED
LEDGER_STRIPED_COUNT=16
LEDGER_DEFAULT_CURRENCY=INR
LEDGER_DEFAULT_FEE_BPS=1000

# Rate Limiter Settings
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_MS=1000

# --- Settlement & Reconciliation Engine ---
SETTLEMENT_MIN_PAYOUT_AMOUNT=10000
SETTLEMENT_MAX_PAYOUT_AMOUNT=50000000
SETTLEMENT_CUTOFF_HOUR_UTC=0

# Reconciliation Matching Engine
RECON_FEE_TOLERANCE_MINORS=1
RECON_PROVIDER_FEE_BPS=150
RECON_PROVIDER_FIXED_FEE=200
RECON_SUBSET_SEARCH_TIMEOUT_MS=5000
RECON_SUBSET_STATE_CAP=50000

# --- Ops Console Frontend Settings ---
VITE_API_BASE_URL=/api
